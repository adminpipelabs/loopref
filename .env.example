# Copy this to .env and fill in your values

# Server
PORT=3000
BASE_URL=https://loopref.com

# Pinterest app (register at developers.pinterest.com)
PINTEREST_CLIENT_ID=your_client_id_here
PINTEREST_CLIENT_SECRET=your_client_secret_here

# Claude (for AI pin content generation)
# Get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database path (optional — defaults to database/loopref.db)
# DB_PATH=/data/loopref.db

# Email (weekly restaurant reports) — any SMTP provider works
# Gmail: host=smtp.gmail.com port=587 user=you@gmail.com pass=app-password
# SendGrid: host=smtp.sendgrid.net port=587 user=apikey pass=SG.xxx
# Postmark: host=smtp.postmarkapp.com port=587 user/pass=server-token
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@loopref.com
SMTP_PASS=your_smtp_password
SMTP_FROM=LoopRef <hello@loopref.com>

# Claude model override (optional — defaults to claude-3-5-sonnet-20241022)
# CLAUDE_MODEL=claude-3-5-haiku-20241022
